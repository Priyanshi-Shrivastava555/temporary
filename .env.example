# AI provider selection: OpenAI is attempted first, Gemini second, then local.
# Values: auto (recommended), openai, or gemini. Startup verifies the selected
# provider before starting an AI phase and automatically falls back in auto mode.
SHOP_BUDDY_AI_PROVIDER=auto
# The URL below is the assessment proxy. For an official OpenAI key, set it to:
# OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_BASE_URL=https://llmgateway-cognizant-assessment.tekstac.com/v1
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Runtime configuration
SHOP_BUDDY_API_URL=http://127.0.0.1:8000
SHOP_BUDDY_DB_PATH=data/shop_buddy.db
# Supported values: langgraph (default), crewai, autogen
WORKFLOW_MODE=langgraph
# Created and verified automatically by ./start.sh --phase1. The VDI evaluator
# uses this key to authenticate against the LangFlow server on port 7860.
LANGFLOW_API_KEY=

# Optional Odoo integration settings. The built-in SQLite catalogue is used until an
# Odoo adapter is configured for the target deployment.
ODOO_ENDPOINT=
ODOO_DB_NAME=
ODOO_ADMIN_USERNAME=
ODOO_ADMIN_PASSWORD=

